# ── Version Control ────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── IDE & Editor ──────────────────────────────────────────────────
.vscode
.idea
*.swp
*.swo
*~

# ── Dependencies ──────────────────────────────────────────────────
node_modules
vendor/node_modules

# ── Build Artifacts ───────────────────────────────────────────────
public/build
hot
*.map

# ── Environment Files ─────────────────────────────────────────────
.env
.env.*
!.env.production.example

